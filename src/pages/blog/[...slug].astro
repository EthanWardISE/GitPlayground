---
import { getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

const slug = Astro.params.slug;
const post = slug ? await getEntry('blog', slug) : undefined;
const blogPost = post
	? (({ author: authorId, ...data }) => ({ authorId, data }))(post.data)
	: undefined;

if (!post) {
	Astro.response.status = 404;
}

const author = blogPost ? await getEntry('authors', blogPost.authorId) : undefined;

if (post && blogPost && !author) {
	throw new Error(`Author "${blogPost.authorId}" was not found for blog post "${post.id}".`);
}

const Content = post ? (await render(post)).Content : undefined;
---

{
	post && blogPost && author && Content ? (
		<BlogPost {...blogPost.data} author={author.data}>
			<Content />
		</BlogPost>
	) : (
		<p>Blog post not found.</p>
	)
}
