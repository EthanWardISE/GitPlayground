---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Developer blogs coming soon — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { display: grid; min-height: 62vh; place-items: center; width: min(760px, calc(100% - 2em)); margin: 0 auto; padding: 80px 0; text-align: center; }
			.notice { padding: 64px 30px; border: 1px solid #e8e2d5; border-radius: 24px; background: #fffefa; box-shadow: 0 18px 60px #3433230d; }
			.mark { display: grid; width: 52px; height: 52px; place-items: center; margin: 0 auto 24px; border-radius: 18px 18px 18px 5px; background: #6b8968; color: #fff; font-family: Georgia, serif; font-size: 34px; font-style: italic; }
			.eyebrow { color: #8c877c; font-size: 10px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; }
			h1 { margin: 18px 0 14px; color: #312f29; font-family: Georgia, serif; font-size: clamp(40px, 7vw, 64px); font-weight: 400; letter-spacing: -2px; line-height: 1; }
			p { max-width: 420px; margin: 0 auto; color: #817d72; font-size: 15px; line-height: 1.7; }
			.back { display: inline-flex; margin-top: 28px; color: #3f5e4d; font-size: 12px; font-weight: 700; }
		</style>
	</head>
	<body>
		<Header />
		<main><section class="notice"><span class="mark" aria-hidden="true">k</span><div class="eyebrow">From the Kinfolk team</div><h1>Developer blogs are coming soon.</h1><p>We&apos;re still gathering our thoughts. Check back soon for build notes, family stories, and a peek behind the scenes at Kinfolk.</p><a class="back" href="/">Back to Kinfolk <span aria-hidden="true">&nbsp;↗</span></a></section></main>
		<Footer />
	</body>
</html>
