---
import AppTheme from '../../components/AppTheme.astro';
import FamilyApp from '../../components/FamilyApp';
import '../../styles/family.css';

const { id } = Astro.params;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<AppTheme />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Family member profile and shared memories." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Family member — Kinfolk</title>
	</head>
	<body>
		<FamilyApp client:load view="person" personId={id} />
	</body>
</html>
